generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model Lead {
  id                 String              @id @default(uuid())
  leadNo             Int                 @unique @default(autoincrement()) // shown as the Lead ID, e.g. L-1024
  name               String
  city               String
  phone              String
  description        String?             @db.Text // notes
  lastContacted      DateTime? // null = never contacted
  type               String // priority: Hot | Warm | Cold
  expectedOrderValue Float // estimated budget
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  nextContactDate    DateTime? // next follow-up (earliest pending LeadFollowUp, kept in sync)
  quotationShared    Boolean             @default(false)
  userId             String? // who created the lead
  user               User?               @relation(fields: [userId], references: [id])
  // Sales CRM (see src/lib/sales-crm.ts)
  altPhone           String?
  whatsapp           String?
  email              String?
  address            String?             @db.Text
  source             String? // Walk-in, Website, Referral, ...
  productInterest    String[]            @default([]) // Curtains, Blinds, Wallpaper, ...
  status             String              @default("NEW") // NEW | ASSIGNED | CONTACTED | INTERESTED | QUOTATION_SENT | FOLLOW_UP | NEGOTIATION | CONVERTED | LOST
  assignedToId       String?
  assignedTo         User?               @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  convertedAt        DateTime?
  lostReason         String?
  quotations         Quotation[]
  measurement        Measurement?
  statusHistory      LeadStatusHistory[]
  assignments        LeadAssignment[]
  activities         LeadActivity[]
  followUps          LeadFollowUp[]
  calls              CallLog[]

  @@index([assignedToId, status])
  @@index([status])
  @@index([nextContactDate])
  @@index([createdAt])
  @@schema("public")
}

model Quotation {
  id              String          @id @default(uuid())
  number          String          @unique
  date            DateTime        @default(now())
  leadId          String
  userId          String?
  subtotal        Float
  tax             Float           @default(0)
  discount        Float           @default(0)
  discountCode    String?
  discountType    String          @default("FIXED")
  total           Float
  status          String          @default("DRAFT")
  description     String?         @db.Text
  services        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  receivedAmount  Float           @default(0)
  previousBalance Float           @default(0)
  deadline        DateTime?
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items           QuotationItem[]

  @@schema("public")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  description String
  quantity    Float
  rate        Float
  discount    Float?    @default(0)
  amount      Float
  details     String?   @db.Text
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Product {
  id            String          @id @default(uuid())
  name          String          @unique
  category      String          @default("")
  unit          String          @default("unit")
  rate          Float
  stockQuantity Int             @default(0) // ACCESSORY: count in hand. FABRIC/TRACK totals come from StockPiece.
  stockKind     String          @default("ACCESSORY") // FABRIC (metres) | TRACK (inches) | ACCESSORY (nos) | OTHER (not stocked)
  lowStockAt    Float? // alert when available stock falls below this, in the kind's base unit
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  stockPieces   StockPiece[]
  stockMoves    StockMovement[]

  @@schema("public")
}

// One physical fabric cut or track piece in the godown.
model StockPiece {
  id        String    @id @default(uuid())
  productId String
  length    Float // FABRIC: metres, TRACK: inches
  status    String    @default("AVAILABLE") // AVAILABLE | USED
  source    String    @default("PURCHASE") // PURCHASE | OFFCUT | RETURN
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  usedAt    DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@schema("public")
}

// Every change to stock, for history. quantity is signed, in the product's base unit.
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  pieceId       String?
  type          String // ADD | USE | DISCARD | ADJUST
  quantity      Float
  note          String?
  userId        String?
  measurementId String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@schema("public")
}

model ShopProduct {
  id             String       @id @default(uuid())
  name           String
  rate           Float
  description    String?      @db.Text
  category       String       @default("Curtains")
  tag            String?
  images         String[] // Array of image URLs
  specifications Json? // JSON object for specs like material, dimensions, etc.
  stock          Int          @default(0)
  rating         Float        @default(0)
  reviewCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reviews        ShopReview[]

  @@schema("public")
}

model ShopReview {
  id            String      @id @default(uuid())
  shopProductId String
  userId        String
  rating        Int // 1-5 stars
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shopProduct   ShopProduct @relation(fields: [shopProductId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopProductId])
  @@index([userId])
  @@schema("public")
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  password      String
  name          String
  role          String            @default("user") // admin, user, customer
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  // Sales CRM: staff ("user") are sales executives unless made a MANAGER; admins see everything
  salesRole     String? // MANAGER | EXECUTIVE | null (= EXECUTIVE)
  managerId     String? // the sales manager this person reports to
  manager       User?             @relation("SalesTeam", fields: [managerId], references: [id], onDelete: SetNull)
  team          User[]            @relation("SalesTeam")
  phone         String? // the person's own mobile, used for click-to-call via the telephony provider
  leads         Lead[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  transactions  Transaction[]
  shopReviews   ShopReview[]
  plannerTopics PlannerTopic[]
  calls         CallLog[]
  followUps     LeadFollowUp[]    @relation("FollowUpAssignee")
  workSessions  WorkSession[]
  workEvents    WorkStatusEvent[]

  @@index([managerId])
  @@schema("public")
}

model Transaction {
  id          String   @id @default(uuid())
  type        String // INCOME, EXPENSE
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  emailId     String?  @unique

  @@schema("public")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  customerEmail String
  customerPhone String
  address       String      @db.Text
  notes         String?     @db.Text
  subtotal      Float
  tax           Float
  total         Float
  paymentMethod String // razorpay, cod
  paymentId     String? // Razorpay payment ID
  status        String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@schema("public")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productRate Float
  quantity    Int
  subtotal    Float
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("public")
}

model Measurement {
  id             String   @id @default(uuid())
  leadId         String?  @unique
  customerName   String?
  title          String?
  data           Json // Nested structure: Floor -> Room -> Window
  images         String[] // URLs of uploaded measurement comments
  referenceFiles Json? // [{ name, url }] of uploaded reference PDFs/files
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@schema("public")
}

model MonthlyBalance {
  id              String   @id @default(uuid())
  month           Int // 0-11 (Jan=0, Dec=11)
  year            Int
  startingBalance Float    @default(0)
  endingBalance   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([month, year])
  @@schema("public")
}

model WeeklyBankBalance {
  id          String   @id @default(uuid())
  weekStart   DateTime // Always a Monday (time zeroed to 00:00:00 UTC)
  bankBalance Float // Actual bank balance
  cashBalance Float    @default(0) // Physical cash in hand
  recordedNet Float // Income - Expenses for that week (computed at entry time)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([weekStart])
  @@schema("public")
}

model Staff {
  id            String            @id @default(uuid())
  name          String
  phone         String?
  designation   String?
  monthlySalary Float
  shiftStart    String            @default("10:00") // HH:mm, India time
  shiftEnd      String            @default("19:00")
  otRatePerHour Float? // ₹ per overtime hour; empty = pay per day ÷ shift hours
  joinedAt      DateTime          @db.Date
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  attendance    StaffAttendance[]
  payments      StaffPayment[]

  @@schema("public")
}

model StaffAttendance {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  status    String   @default("PRESENT") // PRESENT, HALF_DAY, LEAVE (asked by staff, salary deducted), COMPANY_LEAVE (given by company, paid)
  punchIn   String? // HH:mm, India time
  punchOut  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date])
  @@schema("public")
}

model StaffPayment {
  id        String   @id @default(uuid())
  staffId   String
  year      Int
  month     Int // 1-12, the salary month this entry counts against
  type      String   @default("PAYMENT") // PAYMENT (amount paid to staff), BONUS (added to that month's pay)
  amount    Float
  paidOn    DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, year, month])
  @@schema("public")
}

// Planner: a user's own ideas, meeting points and tasks. Each topic is a card
// with a checklist of checkpoints and a description.
model PlannerTopic {
  id          String              @id @default(uuid())
  userId      String
  title       String
  type        String              @default("IDEA") // IDEA | MEETING | TASK
  description String?             @db.Text
  deadline    DateTime?
  done        Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoints PlannerCheckpoint[]

  @@index([userId, done])
  @@schema("public")
}

model PlannerCheckpoint {
  id       String       @id @default(uuid())
  topicId  String
  text     String
  done     Boolean      @default(false)
  position Int          @default(0)
  topic    PlannerTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@schema("public")
}

// Fund allocation: how each month's income is split into buckets (see src/lib/fund-allocation.ts)
model FundBucket {
  id         String         @id @default(uuid())
  name       String
  percent    Float
  kind       String         @default("SPEND") // SPEND | SAVE
  categories String[]       @default([]) // expense categories counted against a SPEND bucket
  position   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  transfers  FundTransfer[]

  @@schema("public")
}

// Money marked as moved into a SAVE bucket's account for a month. Kept apart from Transaction so P&L is unchanged.
model FundTransfer {
  id        String     @id @default(uuid())
  bucketId  String
  month     Int // 0-11
  year      Int
  amount    Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bucket    FundBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([bucketId, month, year])
  @@schema("public")
}

// Work done by a vendor (one line of their bill): nos x type at a price.
model VendorWork {
  id         String   @id @default(uuid())
  vendor     String
  nos        Float
  type       String
  date       DateTime // business day at 00:00 UTC
  price      Float
  notes      String?
  gstPercent Float? // null = no GST
  refNo      String? // vendor's bill no.
  billId     String? // set when the line belongs to a VendorBill (bill's date, GST and no. are copied onto it)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vendor])
  @@index([billId])
  @@schema("public")
}

// Vendor directory: stitching vendors and fabric / blind / track sources. Ledger rows link by name.
model Vendor {
  id        String   @id @default(uuid())
  name      String   @unique
  kind      String   @default("OTHER") // STITCHING | FABRIC | BLINDS | TRACKS | OTHER
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// One vendor bill: several VendorWork lines plus the scanned / PDF bill kept for reference.
model VendorBill {
  id           String   @id @default(uuid())
  vendor       String
  refNo        String?
  date         DateTime // business day at 00:00 UTC
  gstPercent   Float?
  roundOff     Float? // added to the bill total, e.g. 0.20 or -0.30
  notes        String?
  attachmentId String? // Attachment holding the uploaded bill
  fileName     String?
  fileHash     String? // sha256 of the uploaded file, to spot the same bill uploaded twice
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendor])
  @@index([fileHash])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Sales CRM: Sales Funnel > Call Manager > Lead Management
// ---------------------------------------------------------------------------

// Every status change of a lead, with who made it.
model LeadStatusHistory {
  id          String   @id @default(uuid())
  leadId      String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([toStatus, createdAt])
  @@schema("public")
}

// Every (re)assignment of a lead.
model LeadAssignment {
  id           String   @id @default(uuid())
  leadId       String
  fromUserId   String?
  toUserId     String?
  assignedById String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@schema("public")
}

// The lead's timeline: created, edited, note, call, follow-up, status, assignment, quotation.
model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  type      String // CREATED | UPDATED | NOTE | CALL | CALL_DIALED | FOLLOW_UP | STATUS | ASSIGNED | IMPORTED
  summary   String
  data      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@schema("public")
}

// A scheduled follow-up against a lead.
model LeadFollowUp {
  id            String    @id @default(uuid())
  leadId        String
  assignedToId  String?
  createdById   String?
  dueAt         DateTime
  notes         String?
  status        String    @default("PENDING") // PENDING | DONE | RESCHEDULED | CANCELLED
  outcome       String? // what happened, written when completed
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo    User?     @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt])
  @@index([leadId])
  @@index([status, dueAt])
  @@schema("public")
}

// One phone call. Only DEVICE (phone call log uploaded by the CPW Team app) and
// PROVIDER (cloud telephony webhook) calls are verified and count towards talk time;
// MANUAL calls are written by the salesperson and are shown as self-reported.
model CallLog {
  id             String    @id @default(uuid())
  leadId         String?
  userId         String? // sales executive
  phone          String // the customer's number as recorded
  phoneKey       String // last 10 digits, for matching to leads
  direction      String // OUTGOING | INCOMING
  status         String // CONNECTED | MISSED | REJECTED | NOT_ANSWERED | BUSY | FAILED
  source         String // DEVICE | PROVIDER | MANUAL
  provider       String? // exotel, ... (PROVIDER calls)
  externalId     String? // id from the device / provider, to drop duplicates
  startedAt      DateTime
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int? // total, ring + talk
  talkSec        Int? // answered time only
  recordingUrl   String?
  notes          String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([userId, startedAt])
  @@index([leadId, startedAt])
  @@index([startedAt])
  @@index([phoneKey])
  @@schema("public")
}

// Start Work .. End Work. At most one open session per user (partial unique index in SQL).
model WorkSession {
  id        String            @id @default(uuid())
  userId    String
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  endNote   String? // e.g. "Closed automatically at midnight"
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    WorkStatusEvent[]

  @@index([userId, startedAt])
  @@schema("public")
}

// Timestamped status history inside a session. At most one open event per user.
model WorkStatusEvent {
  id        String      @id @default(uuid())
  userId    String
  sessionId String
  status    String // AVAILABLE | ON_CALL | BREAK | LUNCH | MEETING
  startedAt DateTime    @default(now())
  endedAt   DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([sessionId])
  @@schema("public")
}
